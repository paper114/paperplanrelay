NODE_ENV=production
PORT=3000

# Public site origin. Use the final HTTPS domain exposed by Cloudflare Tunnel.
PUBLIC_ORIGIN=https://paperplane.example.com
CORS_ORIGINS=https://paperplane.example.com

# Required in production. Generate a long random value and keep it private.
ADMIN_KEY=replace-with-a-long-random-admin-key

# Prisma SQLite database location. For NAS/Docker, mount this path to persistent storage.
DATABASE_URL=file:/data/paperplane.db

# Optional cache path for the local moderation model.
TRANSFORMERS_CACHE=/data/models

# Build-time frontend compliance/contact labels.
VITE_CONTACT_EMAIL=admin@example.com
VITE_ICP_BEIAN=
VITE_PUBLIC_SECURITY_BEIAN=
